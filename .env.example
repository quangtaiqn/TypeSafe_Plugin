TYPESAFE_API_KEY=replace-with-your-typesafe-api-key
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_MS=30000
TYPESAFE_MAX_REQUEST_BYTES=1048576
TYPESAFE_MAX_RESPONSE_BYTES=4194304
TYPESAFE_MAX_CONCURRENT=2
MCP_HOST=0.0.0.0
PORT=8787
MCP_AUTH_REQUIRED=true
AUTH_ISSUER=https://issuer.example.invalid
AUTH_AUDIENCE=typesafe-mcp
AUTH_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
AUTH_ALLOWED_SUBJECTS=replace-with-authorized-subject
MCP_SCOPE=typesafe:invoke
AUTH_CLOCK_SKEW_SECONDS=60
AUTH_JWKS_CACHE_MS=300000
MCP_MAX_REQUEST_BYTES=1048576
MCP_WINDOW_MS=60000
MCP_MAX_REQUESTS_PER_WINDOW=60
MCP_MAX_SERVICE_REQUESTS_PER_WINDOW=600
